{
	"expo": {
		"name": "BeauWise",
		"slug": "beauwise-client",
		"scheme": "beauwise-client",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"googleServicesFile": "./google-services.json",
			"softwareKeyboardLayoutMode": "resize",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.rise.beauwise"
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"@react-native-firebase/app",
			[
				"react-native-edge-to-edge",
				{
					"android": {
						"parentTheme": "Default",
						"enforceNavigationBarContrast": false
					}
				}
			],
			"expo-web-browser",
			[
				"expo-media-library",
				{
					"savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
					"isAccessMediaLocationEnabled": true,
					"granularPermissions": ["audio", "photo"]
				}
			],
			[
				"react-native-vision-camera",
				{
					"cameraPermissionText": "Beauwise needs access to your Camera."
				}
			],
			"expo-secure-store",
			"@react-native-async-storage/expo-with-async-storage",
			"expo-image-picker",
			[
				"expo-font",
				{
					"fonts": [
						{
							"fontFamily": "Outfit",
							"fontDefinitions": [
								{
									"path": "node_modules/@expo-google-fonts/outfit/100Thin/Outfit_100Thin.ttf",
									"weight": 100
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/200ExtraLight/Outfit_200ExtraLight.ttf",
									"weight": 200
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/300Light/Outfit_300Light.ttf",
									"weight": 300
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
									"weight": 400
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
									"weight": 500
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
									"weight": 600
								},
								{
									"path": "node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf",
									"weight": 700
								}
							]
						}
					]
				}
			],
			"expo-video"
		],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "a3a600e6-771d-488d-8737-2fd5f1b4c5a0"
			}
		},
		"owner": "navi-cc"
	}
}
